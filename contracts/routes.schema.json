{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comuro Route File",
  "type": "object",
  "required": ["version", "routes"],
  "properties": {
    "version": { "const": 1 },
    "routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["id", "name", "coordinates", "buffer_m", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "items": false
          }
        },
        "buffer_m": { "type": "integer", "minimum": 0, "maximum": 500 },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}